          "color": "primary",
          "blocks": [{ "ref": "studio-services-intro" }]
        },
        {
          "id": "studio-service-identity-panel",
          "behavior": "cover",
          "size": "full",
          "align": "center",
          "surface": "solid",
          "color": "secondary",
          "blocks": [{
            "id": "studio-service-identity",
            "type": "Section",
            "layout": "split",
            "splitVariant": "media-lead",
            "surface": "solid",
            "color": "secondary",
            "motion": "scene",
            "motionPreset": "ambient",
            "className": "section--collection-panel",
            "source": { "collection": "services", "query": { "prioritizeIds": ["identity"], "limit": 1 } }
          }]
        },
        {
          "id": "studio-service-website-panel",
          "behavior": "cover",
          "size": "full",
          "align": "center",
          "surface": "solid",
          "color": "special",
          "blocks": [{
            "id": "studio-service-website",
            "type": "Section",
            "layout": "split",
            "splitVariant": "editorial",
            "surface": "solid",
            "color": "special",
            "motion": "scene",
            "motionPreset": "ambient",
            "className": "section--collection-panel",
            "source": { "collection": "services", "query": { "prioritizeIds": ["website"], "limit": 1 } }
          }]
        },
        {
          "id": "studio-service-integrations-panel",
          "behavior": "cover",
          "size": "full",
          "align": "center",
          "surface": "solid",
          "color": "accent",
          "blocks": [{
            "id": "studio-service-integrations",
            "type": "Section",
            "layout": "split",
            "splitVariant": "media-lead",
            "surface": "solid",
            "color": "accent",
            "motion": "scene",
            "motionPreset": "ambient",
            "className": "section--collection-panel",
