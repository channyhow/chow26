{
  "id": "studio",
  "slug": "/studio",
  "seo": {
    "title": "Studio, services & approche | Chow Studio",
    "description": "Découvrez Chow Studio, ses services, son approche du design et du développement frontend, et la pratique de Channy How-Choong entre Paris et La Réunion.",
