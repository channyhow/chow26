                    { "label": "Identité visuelle", "href": "#studio-service-identity-panel" },
                    { "label": "Site internet", "href": "#studio-service-website-panel" },
                    { "label": "Fonctionnalités & intégrations", "href": "#studio-service-integrations-panel" }
