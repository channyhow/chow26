{
  "home-opening": {
    "id": "home-opening",
    "type": "Section",
    "layout": "media-overlay",
    "content": {
      "header": {
        "eyebrow": "Atmosphere Studio · Paris · La Réunion",
        "title": "Architecture intérieure. Usages, lumière, matières.",
        "text": [
          "Studio d’architecture intérieure entre Paris, l’Île-de-France et La Réunion, pour des projets résidentiels sobres, sensibles et faciles à habiter."
        ],
        "links": [
          {
            "label": "Voir les projets",
            "href": "/projets",
            "intent": "navigate",
            "priority": "primary"
          },
          {
            "label": "L’approche",
            "href": "/approche",
            "intent": "navigate",
            "priority": "secondary"
          }
        ]
      },
      "media": "home-cover"
    }
  },
  "projects-featured": {
    "id": "projects-featured",
    "type": "Section",
    "layout": "carousel",
    "source": {
      "collection": "projects",
      "query": {
        "featured": true,
        "limit": 3
      }
    },
    "content": {
      "header": {
        "eyebrow": "Projets sélectionnés",
        "title": "Paris. Lisbonne. Bali.",
        "text": [
          "Trois lieux, trois réponses construites à partir des usages, de la lumière et des matières."
        ]
      }
    }
  },
  "project-gallery": {
    "id": "project-gallery",
    "type": "Section",
    "layout": "grid",
    "source": {
      "collection": "projects"
    },
    "content": {
      "header": {
        "eyebrow": "Projets résidentiels",
        "title": "Passages, matières, lumière.",
        "text": [
          "Chaque projet répond à un lieu, à ses usages et à une manière particulière d’habiter."
        ]
      }
    }
  },
  "home-services": {
    "id": "home-services",
    "type": "Section",
    "layout": "grid",
    "source": {
      "collection": "services",
      "query": {
        "featured": true,
        "limit": 3
      }
    },
    "content": {
      "header": {
        "eyebrow": "Services",
        "title": "Du plan au détail.",
        "text": [
          "Architecture intérieure, direction d’ambiance, mobilier et stylisme, selon l’état d’avancement du projet."
        ]
      }
    }
  },
  "approach-default": {
    "id": "approach-default",
    "type": "Section",
    "layout": "grid",
    "source": {
      "collection": "approach"
    },
    "content": {
      "header": {
        "eyebrow": "Approche",
        "title": "Les usages d’abord.",
        "text": [
          "Circulations, lumière, volumes et contraintes du lieu guident le projet. Les matières et le mobilier viennent ensuite préciser la réponse."
        ]
      }
    }
  },
  "studio-founders": {
    "id": "studio-founders",
    "type": "Section",
    "layout": "grid",
    "content": {
      "header": {
        "eyebrow": "Le studio",
        "title": "Observer avant de transformer.",
        "text": [
          "Fondé à la Réunion par Maëlle Payet et Guillaume Hoarau, Atmosphere Studio travaille à partir du lieu, de ses usages et de sa lumière pour construire des intérieurs clairs, sensibles et durables."
        ]
      },
      "items": [
        {
          "eyebrow": "Cofondatrice · Architecture intérieure",
          "title": "Maëlle Payet",
          "text": [
            "Maëlle travaille les volumes, les circulations et les usages, de l’intention initiale aux matières et aux finitions."
          ],
          "media": [
            "studio-founder-1"
          ]
        },
        {
          "eyebrow": "Cofondateur · Direction d’ambiance",
          "title": "Guillaume Hoarau",
          "text": [
            "Guillaume compose les couleurs, le mobilier et la lumière pour donner à chaque projet une atmosphère cohérente et personnelle."
          ],
          "media": [
            "studio-founder-2"
          ]
        }
      ]
    }
  },
  "approach-method": {
    "id": "approach-method",
    "type": "Section",
    "layout": "grid",
    "source": {
      "collection": "approach"
    },
    "content": {
      "header": {
        "eyebrow": "Approche",
        "title": "Du lieu à l’atmosphère.",
        "text": [
          "Trois principes guident les décisions, de la première esquisse aux derniers détails."
        ]
      }
    }
  },
  "journal-default": {
    "id": "journal-default",
    "type": "Section",
    "layout": "carousel",
