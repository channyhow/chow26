{
  "name": "chow-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:import": "node scripts/import-source-assets.mjs",
    "seo:generate": "node scripts/generate-seo.mjs",
    "predev": "npm run seo:generate && npm run content:audit",
    "dev": "vite",
    "prebuild": "npm run seo:generate && npm run content:audit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "security:audit": "node scripts/security-audit.mjs && npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run security:audit && npm run build",
    "content:audit": "node scripts/audit-content.mjs",
    "postbuild": "node scripts/render-static-seo.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "motion": "12.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "sass": "1.101.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5"
  },
  "engines": {
    "node": "22.x"
  }
}
